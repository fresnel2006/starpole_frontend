# Copiez ce fichier en .env.local (ignoré par Git) et remplissez les valeurs.
# Console Firebase > Paramètres du projet > Vos applications > application Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Jeton PUBLIC Mapbox (commence par pk.), limité aux adresses de la console si possible.
VITE_MAPBOX_JETON=

# Serveur FastAPI (facultatif, valeur par défaut ci-dessous).
VITE_URL_SERVEUR=https://starpole-backend.vercel.app
